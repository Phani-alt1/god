body {
    font-family: Arial;
    margin: 0;
    background-color: #f2f2f2;
}


/* HEADER */

header {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 20px;
}


/* NAVIGATION */

nav {
    background-color: #555;
    padding: 12px;
    text-align: center;
}

nav button {
    background-color: white;
    border: none;
    padding: 10px 15px;
    margin: 5px;
    cursor: pointer;
}


/* SECTIONS */

section {
    background-color: white;
    margin: 20px auto;
    padding: 20px;
    width: 80%;
    border-radius: 10px;
}


/* INPUTS */

input,
select {
    padding: 10px;
    margin: 5px;
    width: 250px;
}


/* BUTTONS */

button {
    padding: 10px 15px;
    cursor: pointer;
}


/* BOOK CARD */

.book {
    border: 1px solid #ccc;
    padding: 15px;
    margin: 10px;
    border-radius: 8px;
}


/* TABLE */

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th,
td {
    border: 1px solid #aaa;
    padding: 10px;
    text-align: center;
}

th {
    background-color: #ddd;
}


/* HIDE SECTION */

.hidden {
    display: none;
}


/* MESSAGES */

#registerMessage,
#loginMessage,
#contactResult,
#fineResult {
    color: green;
    font-weight: bold;
}
--------------------------------------------------------------
/* SHOW SECTION */

function showSection(sectionName) {

    let sections = document.querySelectorAll("section");

    sections.forEach(function(section) {
        section.classList.add("hidden");
    });

    document.getElementById(sectionName)
            .classList.remove("hidden");
}


/* SEARCH BOOK */

function searchBooks() {

    let input =
        document.getElementById("searchBook")
        .value.toLowerCase();

    let books =
        document.getElementById("bookList")
        .getElementsByClassName("book");

    for(let i = 0; i < books.length; i++) {

        let text =
            books[i].innerText.toLowerCase();

        if(text.includes(input)) {

            books[i].style.display = "block";

        }
        else {

            books[i].style.display = "none";

        }
    }
}


/* VIEW BOOK DETAILS */

function viewBook(name) {

    document.getElementById("bookDetails").innerHTML =
        "<b>Book Details:</b><br>" +
        "Book Name: " + name + "<br>" +
        "Available: Yes<br>" +
        "You can issue this book from the library.";
}


/* REGISTER */

function register() {

    let name =
        document.getElementById("regName").value;

    let email =
        document.getElementById("regEmail").value;

    let password =
        document.getElementById("regPassword").value;


    if(name === "" || email === "" || password === "") {

        document.getElementById("registerMessage").innerHTML =
            "Please fill all fields.";

    }
    else {

        document.getElementById("registerMessage").innerHTML =
            "Registration Successful!";

    }
}


/* LOGIN */

function login() {

    let email =
        document.getElementById("loginEmail").value;

    let password =
        document.getElementById("loginPassword").value;


    if(email === "" || password === "") {

        document.getElementById("loginMessage").innerHTML =
            "Please enter email and password.";

    }
    else {

        document.getElementById("loginMessage").innerHTML =
            "Login Successful!";

    }
}


/* ADD BOOK */

function addBook() {

    let book =
        document.getElementById("newBook").value;


    if(book === "") {

        alert("Enter book name");

        return;
    }


    let div = document.createElement("div");

    div.className = "book";

    div.innerHTML =
        "<h3>" + book + "</h3>" +
        "<p>Available: Yes</p>";


    document.getElementById("adminBookList")
            .appendChild(div);


    document.getElementById("newBook").value = "";
}


/* ISSUE BOOK */

function issueBook() {

    let student =
        document.getElementById("studentName").value;

    let book =
        document.getElementById("issueBook").value;


    if(student === "" || book === "") {

        alert("Enter student and book details");

        return;
    }


    alert(
        "Book Issued Successfully!\n" +
        "Student: " + student +
        "\nBook: " + book
    );
}


/* FINE CALCULATION */

function calculateFine() {

    let days =
        Number(document.getElementById("lateDays").value);

    let fine = days * 10;


    document.getElementById("fineResult").innerHTML =
        "Fine Amount = ₹" + fine;
}


/* MATERIAL SEARCH */

function searchMaterial() {

    let year =
        document.getElementById("materialYear").value;

    let semester =
        document.getElementById("semester").value;


    document.getElementById("materialResult").innerHTML =
        "Materials available for Year " +
        year +
        ", Semester " +
        semester +
        "<br><br>" +
        "<button>Download Material</button>";
}


/* CONTACT FORM */

function contactForm(event) {

    event.preventDefault();


    let name =
        document.getElementById("contactName").value;


    document.getElementById("contactResult").innerHTML =
        "Thank you " + name +
        "! Your message has been submitted.";
}
